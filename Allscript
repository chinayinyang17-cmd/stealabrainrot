				if ok3 and body and writefile and getcustomasset then
					local path = filePrefix .. ".png"
					writefile(path, body.Body)
					iconAsset = getcustomasset(path)
				end
			end
			return { icon = iconAsset, name = guild.name or code, members = members }
		end

