	local function formatGen(value)
		if not value or value == 0 then return "$0/s" end
		local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
		local tier = math.floor(math.log10(math.abs(value)) / 3)
		if tier == 0 then
			return "$" .. tostring(math.floor(value)) .. "/s"
		end
		local num = string.format("%.1f", value / (1000 ^ tier))
		if num:sub(-2) == ".0" then num = num:sub(1, -3) end
		return "$" .. num .. (suffixes[tier + 1] or "") .. "/s"
	end

	local function computeGen(index, mutation, traits)
		if type(index) ~= "string" then return 0 end
		local animal = Animals[index]
		if not animal then return 0 end
		local generation = animal.Generation or (animal.Price * GameData.Game.AnimalGanerationModifier)
		local mult = 1
		if mutation and mutation ~= "None" and Mutations[mutation] then
			mult = 1 + Mutations[mutation].Modifier
		end
		if traits then
			local sleepy = false
			for _, t in ipairs(traits) do
				if t == "Sleepy" then
					sleepy = true
				elseif Traits[t] then
					mult = mult + Traits[t].MultiplierModifier
				end
			end
			if sleepy then mult = mult * 0.5 end
		end
		return math.round(generation * mult)
	end

