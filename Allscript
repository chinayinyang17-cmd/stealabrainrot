	local function isTradeNotifyText(msg)
		if typeof(msg) ~= "string" then return false end
		local plain = msg:gsub("<[^>]+>", "")
		local lower = plain:lower()
		local hasAt = plain:find("@") ~= nil
		return (hasAt and lower:find("cancel"))
			or (plain:find("Failed") and lower:find("trade"))
			or (hasAt and lower:find("completed"))
			or (lower:find("other player") and lower:find("enough space"))
	end

	-- [FIX #3] Whitelist kick-like text so real reason is not suppressed
